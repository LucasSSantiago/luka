<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cadastro - Luka</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
  </head>
  <body>
    <main class="min-h-screen bg-[var(--color-page)] px-6 py-16 text-[var(--color-text)]">
      <div class="mx-auto flex max-w-xl flex-col gap-6">
        <div>
          <p class="text-sm font-semibold text-[var(--color-primary)]">Input</p>
          <h1 class="mt-2 text-2xl font-semibold">Preview do componente</h1>
        </div>

        @!ui.input({
          name: 'email',
          type: 'email',
          placeholder: 'voce@exemplo.com',
        })

        @!ui.input({
          name: 'password',
          type: 'password',
          placeholder: 'Sua senha',
        })

        @!ui.input({
          name: 'disabledExample',
          placeholder: 'Campo desabilitado',
          disabled: true,
        })
      </div>
    </main>
  </body>
</html>
