@layouts.marketing()
  <section class="mx-auto w-full max-w-[1344px] px-6 py-12">
    <h1 class="mb-8 text-2xl font-bold">Práticas para você</h1>

    @if(videos.length)
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        @each(video in videos)
          @!videoCard({
            title: video.title,
            author: video.user.fullName,
            publishedAt: video.createdAt,
            route: 'videos.show',
            routeParams: { id: video.id },
          })
        @end
      </div>
    @else
      <p class="text-[var(--color-text-muted)]">
        Nenhum vídeo publicado ainda.
      </p>
    @end
  </section>
@end