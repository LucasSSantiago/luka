@layouts.app({
  title: 'Publicar vídeo',
  navbar: { publishRoute: 'videos.upload' },
})
  <main class="mx-auto w-full max-w-2xl px-5 py-10">
    <section
      class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8"
      aria-labelledby="upload-title"
    >
      <h1 id="upload-title" class="text-2xl font-semibold text-[var(--color-text)]">
        Publicar vídeo
      </h1>

      <p class="mt-2 text-sm text-[var(--color-text-muted)]">Envie um vídeo MP4 de até 250 MB.</p>

      <form
        id="video-upload-form"
        action="{{ urlFor('videos.uploads.start') }}"
        method="POST"
        class="mt-6 flex flex-col gap-5"
        data-complete-url="{{ urlFor('videos.uploads.complete', { id: 'VIDEO_ID' }) }}"
      >
        {{ csrfField() }}
        @ui.field({ name: 'title', label: 'Título' })
          @!ui.input({
            name: 'title',
            required: true,
            maxlength: 150,
            placeholder: 'Ex.: Alongamento para começar o dia',
          })
        @end
        @ui.field({ name: 'description', label: 'Descrição (opcional)' })
          <textarea
            id="description"
            name="description"
            rows="4"
            maxlength="500"
            class="w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-page)] px-4 py-3 text-[var(--color-text)]"
          ></textarea>
        @end
        @ui.field({ name: 'videoFile', label: 'Arquivo de vídeo' })
          <input
            id="videoFile"
            name="videoFile"
            type="file"
            accept=".mp4,video/mp4"
            required
            aria-describedby="video-file-help"
            class="block w-full text-sm text-[var(--color-text)]"
          />
          <p id="video-file-help" class="text-sm text-[var(--color-text-muted)]">
            Selecione um arquivo MP4 de até 250.000.000 bytes.
          </p>
        @end

        <div id="upload-progress-container" hidden>
          <label for="upload-progress" class="text-sm">Progresso do envio</label>
          <progress id="upload-progress" max="100" value="0" class="mt-2 block w-full"></progress>
        </div>

        <p
          id="upload-message"
          role="status"
          aria-live="polite"
          class="text-sm text-[var(--color-text)]"
        ></p>
        @!ui.button({
          text: 'Enviar vídeo',
          type: 'submit',
          disabled: true,
          class: 'w-full',
        })
      </form>
    </section>
  </main>
@end
