@let(name = $props.get('name'))
@let(id = $props.get('id', name))
@let(label = $props.get('label'))
@let(errors = flashMessages.get('inputErrorsBag', {}) [name] ?? [])
@let(hasErrors = errors.length > 0)

<div class="flex flex-col gap-2">
  <label
    for="{{ id }}"
    class="text-sm font-medium text-[var(--color-text-soft)]"
  >
    {{ label }}
  </label>

  {{{ await $slots.main() }}}

  @if(hasErrors)
  <div
    id="{{ id }}-error"
    class="text-sm text-[var(--color-danger)]"
  >
    @each(message in errors)
      <p> {{ message }} </p>
    @end
  </div>
  @end
</div>
