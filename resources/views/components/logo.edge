@let(size = $props.get('size', 40))
@link({
  route: 'home',
  'aria-label': 'Luka — início',
  class: ['inline-flex shrink-0 items-center', $props.get('class', '')],
})
  <img
    src="/images/Logo-Theme=Light.svg"
    width="{{ size * 2.8 }}"
    height="{{ size }}"
    alt=""
    class="dark:hidden!"
  />
  <img
    src="/images/Logo-Theme=Dark.svg"
    width="{{ size * 2.8 }}"
    height="{{ size }}"
    alt=""
    class="hidden! dark:block!"
  />
@end
