{{-- O usuário vem da sessão, verificada pelo middleware silent_auth. --}}
@if(auth.user)
  <details
    class="relative"
    x-data="{}"
    x-on:click.outside="$el.removeAttribute('open')"
    x-on:keydown.escape.prevent.stop="$el.removeAttribute('open'); $refs.toggle.focus()"
  >
    <summary
      x-ref="toggle"
      aria-label="Abrir opções da conta"
      class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-primary-soft)] text-sm font-semibold text-[var(--color-text)] transition-shadow hover:ring-4 hover:ring-[var(--color-focus-ring)] [&::-webkit-details-marker]:hidden"
    >
      @!avatar({ initials: auth.user.initials, 'aria-hidden': 'true' })
    </summary>
    <div
      class="absolute top-13 right-0 w-60 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-2 shadow-[var(--shadow-soft)]"
    >
      @if($props.get('route'))
        @link({
          route: $props.get('route'),
          class: 'block rounded-lg px-3 py-2 text-sm hover:bg-[var(--color-page)]',
        })
          {{ $props.get('label', 'Ver perfil') }}
        @end
      @else
        <button type="button" disabled class="block w-full cursor-default! rounded-lg px-3 py-2 text-left text-sm text-[var(--color-text-muted)]">
          {{ $props.get('label', 'Ver perfil') }}
        </button>
      @end
      @form({ route: 'session.destroy', method: 'POST' })
        @!ui.button({
          text: 'Sair',
          type: 'submit',
          class:
            'min-h-10! w-full justify-start! rounded-lg! bg-transparent! px-3! text-sm text-[var(--color-text)]! font-medium! hover:bg-[var(--color-page)]!',
        })
      @end
    </div>
  </details>
@end
