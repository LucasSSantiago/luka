{{-- Passe apenas nomes de rotas que já existam; sem destino, a ação fica indisponível. --}}
@let(exploreRoute = $props.get('exploreRoute'))
@let(creatorsRoute = $props.get('creatorsRoute'))
@let(publishRoute = $props.get('publishRoute'))
{{-- Sete colunas; o espaço restante é distribuído igualmente entre os elementos do frame. --}}
@let(desktopGridClasses = auth.user
  ? 'xl:grid-cols-[112px_56px_72px_400px_40px_40px_40px] xl:gap-x-[calc((100%_-_760px)/6)]'
  : 'xl:grid-cols-[112px_56px_72px_400px_40px_80px_136px] xl:gap-x-[calc((100%_-_896px)/6)]')
<header
  class="relative z-20 border-b border-[var(--color-border)] bg-[var(--color-surface)] xl:border-b-0"
>
  <div
    class="grid w-full grid-cols-[auto_1fr] items-center gap-x-3 gap-y-3 px-5 py-4 sm:gap-x-6 sm:px-8 xl:h-24 xl:gap-y-0 xl:px-6 xl:py-0 {{ desktopGridClasses }}"
  >
    @!logo({ size: 40, class: '[&_img]:h-8 [&_img]:w-auto xl:[&_img]:h-10' })

    <nav
      aria-label="Navegação principal"
      class="col-span-2 row-start-2 flex items-center gap-6 text-sm sm:col-span-1 xl:col-span-2 xl:col-start-2 xl:row-start-1 xl:grid xl:grid-cols-subgrid xl:gap-x-[normal]"
    >
      @if(exploreRoute)
        @navLink({
          route: exploreRoute,
          class:
            'rounded-sm text-[var(--color-text-soft)] hover:text-[var(--color-primary)] aria-[current=page]:font-semibold aria-[current=page]:text-[var(--color-primary)]',
        })
          Explorar
        @end
      @else
        <span aria-disabled="true" class="text-[var(--color-text-muted)]">
          Explorar<span class="sr-only">— em breve</span>
        </span>
      @end
      @if(creatorsRoute)
        @navLink({
          route: creatorsRoute,
          class:
            'rounded-sm text-[var(--color-text-soft)] hover:text-[var(--color-primary)] aria-[current=page]:font-semibold aria-[current=page]:text-[var(--color-primary)]',
        })
          Criadores
        @end
      @else
        <span aria-disabled="true" class="text-[var(--color-text-muted)]">
          Criadores<span class="sr-only">— em breve</span>
        </span>
      @end
    </nav>

    <div
      class="col-span-2 row-start-3 min-w-0 sm:col-span-1 sm:col-start-2 sm:row-start-2 xl:col-start-4 xl:row-start-1"
    >
      @!navbar.search({
        route: $props.get('searchRoute'),
        value: $props.get('search', ''),
      })
    </div>

    <div
      class="col-start-2 row-start-1 flex items-center justify-self-end gap-1 sm:gap-3 xl:col-span-3 xl:col-start-5 xl:grid xl:grid-cols-subgrid xl:justify-self-stretch xl:gap-x-[normal]"
    >
      @!themeToggle()
      @if(auth.user)
        @if(publishRoute)
          @link({
            route: publishRoute,
            'aria-label': 'Publicar vídeo',
            class:
              'inline-flex size-10 items-center justify-center rounded-lg bg-[var(--color-primary)] text-[var(--color-on-primary)] hover:bg-[var(--color-primary-hover)]',
          })
            @svg('lucide:plus', { width: 20, height: 20, 'aria-hidden': 'true' })
          @end
        @else
          <button
            type="button"
            disabled
            aria-label="Publicar vídeo — em breve"
            class="inline-flex size-10 cursor-default! items-center justify-center rounded-lg border border-[var(--color-border)] text-[var(--color-text-muted)]"
          >
            @svg('lucide:plus', { width: 20, height: 20, 'aria-hidden': 'true' })
          </button>
        @end
        @!navbar.accountMenu({
          route: $props.get('accountRoute'),
          label: $props.get('accountLabel', 'Meu perfil'),
        })
      @else
        @link({
          route: 'session.create',
          class:
            'rounded-lg px-2 py-2 text-xs text-[var(--color-text-soft)] hover:text-[var(--color-primary)] sm:px-3 sm:text-sm xl:flex xl:h-12 xl:w-20 xl:items-center xl:justify-center xl:p-0',
        })
          Entrar
        @end
        @link({
          route: 'new_account.create',
          class:
            'whitespace-nowrap rounded-lg bg-[var(--color-primary)] px-2 py-2 text-xs font-semibold text-[var(--color-on-primary)] hover:bg-[var(--color-primary-hover)] sm:px-4 sm:text-sm xl:flex xl:h-12 xl:w-[136px] xl:items-center xl:justify-center xl:p-0',
        })
          Criar conta
        @end
      @end
    </div>
  </div>
</header>
