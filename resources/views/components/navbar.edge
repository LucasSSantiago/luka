{{-- Cada destino pode ser conectado quando sua rota estiver disponível. --}}
@let(publishRoute = $props.get('publishRoute', 'videos.upload'))
<header class="relative z-20 border-b border-[var(--color-border)] bg-[var(--color-surface)]">
  <div
    class="grid w-full grid-cols-[auto_1fr] items-center gap-x-2 gap-y-3 px-4 py-4 sm:gap-x-6 sm:px-6 md:grid-cols-[auto_1fr_auto] lg:grid-cols-[auto_auto_minmax(200px,1fr)_auto] lg:gap-x-8"
  >
    @!logo({ size: 36, class: '[&_img]:h-8 [&_img]:w-auto sm:[&_img]:h-9' })

    <nav
      aria-label="Navegação principal"
      class="col-span-2 row-start-3 flex items-center gap-1 border-t border-[var(--color-border)] pt-3 md:col-span-1 md:col-start-2 md:row-start-1 md:ml-2 md:translate-y-1 md:border-0 md:pt-0 lg:ml-0"
    >
      @!navbar.item({ label: 'Explorar', route: $props.get('exploreRoute') })
    </nav>

    <div
      class="col-span-2 row-start-2 min-w-0 md:col-span-3 md:col-start-1 lg:col-span-1 lg:col-start-3 lg:row-start-1 lg:w-full lg:max-w-[520px] lg:justify-self-center"
    >
      @!navbar.search({
        route: $props.get('searchRoute'),
        value: $props.get('search', ''),
      })
    </div>

    <div
      class="col-start-2 row-start-1 flex items-center justify-self-end gap-1 sm:gap-3 md:col-start-3 lg:col-start-4"
    >
      @!themeToggle()
      <div class="flex items-center gap-1 sm:gap-2">
        @if(auth.user)
          @if(publishRoute)
            @link({
              route: publishRoute,
              'aria-label': 'Publicar vídeo',
              class:
                'inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary)] text-[var(--color-on-primary)] transition-colors hover:bg-[var(--color-primary-hover)]',
            })
              @svg('lucide:plus', { width: 20, height: 20, 'aria-hidden': 'true' })
            @end
          @else
            <button
              type="button"
              disabled
              aria-label="Publicar vídeo — em breve"
              class="inline-flex size-10 shrink-0 cursor-default! items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-page)] text-[var(--color-text-muted)]"
            >
              @svg('lucide:plus', { width: 20, height: 20, 'aria-hidden': 'true' })
            </button>
          @end
          @!navbar.accountMenu({
            route: $props.get('accountRoute'),
            label: $props.get('accountLabel', 'Ver perfil'),
          })
        @else
          @link({
            route: 'session.create',
            class:
              'inline-flex h-9 shrink-0 items-center justify-center rounded-full px-2 text-xs font-medium text-[var(--color-text-soft)] transition-colors hover:bg-[var(--color-page)] hover:text-[var(--color-text)] sm:h-10 sm:px-4 sm:text-sm',
          })
            Entrar
          @end
          @link({
            route: 'new_account.create',
            class:
              'inline-flex h-9 shrink-0 items-center justify-center whitespace-nowrap rounded-full bg-[var(--color-primary)] px-3 text-xs font-semibold text-[var(--color-on-primary)] transition-colors hover:bg-[var(--color-primary-hover)] sm:h-10 sm:px-5 sm:text-sm',
          })
            Criar conta
          @end
        @end
      </div>
    </div>
  </div>
</header>
