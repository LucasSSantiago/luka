{{--
  Top-level app navigation. Add an entry here for every new area of your
  app, and it shows up in the navigation bar with its active state handled.
--}}
@let(nav = [{ label: 'Dashboard', route: 'dashboard', icon: 'lucide:house' }])
@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html
  lang="pt-BR"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle ? `${pageTitle} — Luka` : 'Luka' }}</title>
    @include('partials/fonts')
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    @!navbar($props.get('navbar', {}))

    <nav class="subnav">
      <div class="subnav__inner">
        @each(item in nav)
          @navLink({ route: item.route, class: 'subnav__item' })
            @if(item.icon)
              @svg(item.icon, { width: 14, height: 14 })
            @end
            {{ item.label }}
          @end
        @end
      </div>
    </nav>

    <div class="app-main">{{{ await $slots.main() }}}</div>
    @include('partials/flash_alerts')
  </body>
</html>
